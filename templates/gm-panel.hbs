<div class="spt-gm">
  {{!-- Status bar: network, pending messages, ongoing call --}}
  <header class="spt-gm-status {{#if down}}down{{/if}}" aria-label="{{spt "Gm.Status"}}">
    <span class="spt-pill"><i class="fas fa-signal" title="{{spt "Net.Mobile"}}"></i><i class="fas fa-wifi" title="{{spt "Net.Wifi"}}"></i> {{#if down}}{{spt "Net.DownAll"}}{{else}}{{spt "Net.Ok"}}{{/if}}</span>
    {{#each jams}}<a class="spt-pill spt-jam-pill" data-action="openPhone" data-uuid="{{uuid}}" title="{{spt "Jammer.Open"}}"><i class="fas fa-tower-broadcast"></i> {{label}}</a>{{/each}}
    {{#if pending}}<span class="spt-gm-pending">{{spt "Net.Pending" n=pending}}</span>{{/if}}
    {{#if satSky}}<i class="fas fa-satellite spt-gm-satsky" title="{{spt "Satellite.SkyOpen" scenes=satSky}}"></i>{{/if}}
    <button type="button" class="spt-gm-net" data-action="toggleNetwork">{{#if down}}{{spt "Net.Restore"}}{{else}}{{spt "Net.Cut"}}{{/if}}</button>
    <button type="button" class="spt-gm-help {{#if settingsView}}active{{/if}}" data-action="openSettings" title="{{spt "Gm.Settings"}}" aria-label="{{spt "Gm.Settings"}}"><i class="fas fa-gear"></i></button>
    <button type="button" class="spt-gm-help" data-action="welcome" title="{{spt "Welcome.Help"}}" aria-label="{{spt "Welcome.Help"}}"><i class="fas fa-circle-question"></i></button>
  </header>
  {{#if ringing}}
  <div class="spt-gm-ringing">
    <i class="fas fa-phone-volume"></i> {{spt "Gm.RingingAt" who=ringing}}
    <button type="button" data-action="hangup" title="{{spt "Call.HangUp"}}" aria-label="{{spt "Call.HangUp"}}"><i class="fas fa-phone-slash"></i></button>
  </div>
  {{/if}}

  {{#if settingsView}}
  {{!-- Module settings: replaces the tabs until closed --}}
  <div class="spt-tab-body">
    <section class="spt-gm-settings">
      <header class="spt-set-head"><strong><i class="fas fa-gear"></i> {{spt "Gm.Settings"}}</strong><a data-action="closeSettings"><i class="fas fa-arrow-left"></i> {{spt "Gm.Back"}}</a></header>
      {{#each settingsView.rows}}
      <div class="spt-set-row">
        <div class="spt-set-label">{{#if icon}}<i class="fas {{icon}} spt-set-icon"></i> {{/if}}{{name}}{{#if client}} <small class="spt-dim">({{spt "Gm.ThisComputer"}})</small>{{/if}}{{#if hint}}<p class="hint">{{hint}}</p>{{/if}}</div>
        <div class="spt-set-field">
          {{#if select}}<select data-setting="{{key}}">{{#each options}}<option value="{{value}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}</select>{{/if}}
          {{#if bool}}<input type="checkbox" data-setting="{{key}}" {{#if checked}}checked{{/if}}>{{/if}}
          {{#if range}}<input type="range" data-setting="{{key}}" min="{{min}}" max="{{max}}" step="{{step}}" value="{{value}}">{{/if}}
          {{#if number}}<input type="number" data-setting="{{key}}" value="{{value}}">{{/if}}
          {{#if text}}<input type="text" data-setting="{{key}}" value="{{value}}">{{/if}}
        </div>
      </div>
      {{/each}}
      {{#if settingsView.reloadNeeded}}<p class="spt-set-reload"><i class="fas fa-rotate"></i> {{spt "Gm.ReloadNeeded"}} <button type="button" data-action="reloadWorld">{{spt "Gm.Reload"}}</button></p>{{/if}}
      <div class="spt-set-advanced">
        <h3 class="spt-set-title">{{spt "Features.Title"}}</h3>
        <p class="spt-set-quip">{{spt "Features.Hint"}}</p>
        {{#each settingsView.features}}
        <label class="spt-set-row spt-set-feature"><div class="spt-set-field"><input type="checkbox" data-feature="{{key}}" {{#if checked}}checked{{/if}}></div><div class="spt-set-label">{{#if icon}}<i class="fas {{icon}} spt-set-icon"></i> {{/if}}{{name}}<p class="hint">{{hint}}</p></div></label>
        {{/each}}
      </div>
      <p class="spt-set-foot"><a data-action="foundrySettings"><i class="fas fa-sliders"></i> {{spt "Gm.FoundrySettings"}}</a></p>
    </section>
  </div>
  {{else}}
  {{!-- Tabs --}}
  <nav class="spt-tabs" role="tablist">
    <a class="spt-tab {{#if (eq tab "send")}}active{{/if}}" data-action="switchTab" data-tab="send" role="tab"><i class="fas fa-paper-plane"></i> {{spt "Gm.TabSend"}}</a>
    <a class="spt-tab {{#if (eq tab "inbox")}}active{{/if}}" data-action="switchTab" data-tab="inbox" role="tab"><i class="fas fa-inbox"></i> {{spt "Gm.TabInbox"}}{{#if inboxUnread}} <span class="spt-badge">{{inboxUnread}}</span>{{/if}}</a>
    <a class="spt-tab {{#if (eq tab "directory")}}active{{/if}}" data-action="switchTab" data-tab="directory" role="tab"><i class="fas fa-address-book"></i> {{spt "Directory.Title"}}{{#if unknownCount}} <span class="spt-badge" title="{{spt "Directory.ToIdentify"}}">{{unknownCount}}</span>{{/if}}</a>
    <a class="spt-tab {{#if (eq tab "devices")}}active{{/if}}" data-action="switchTab" data-tab="devices" role="tab"><i class="fas fa-mobile-screen"></i> {{spt "Gm.TabDevices"}} <span class="spt-count">{{deviceCount}}</span></a>
    <a class="spt-tab {{#if (eq tab "files")}}active{{/if}}" data-action="switchTab" data-tab="files" role="tab"><i class="fas fa-folder-tree"></i> {{spt "Files.Tab"}}{{#if fileCount}} <span class="spt-count">{{fileCount}}</span>{{/if}}</a>
    {{#if feat.intel}}<a class="spt-tab {{#if (eq tab "watch")}}active{{/if}}" data-action="switchTab" data-tab="watch" role="tab" title="{{spt "Gm.WatchHint"}}"><i class="fas fa-eye"></i> {{spt "Gm.TabWatch"}}{{#if listenNew}} <span class="spt-count" title="{{spt "Gm.ListenNew"}}">{{listenNew}}</span>{{/if}}</a>{{/if}}
  </nav>

  <div class="spt-tab-body">
  {{#if (eq tab "send")}}
    <section class="spt-gm-send">
      <div class="spt-send-to">
        {{#if noAgents}}<p class="spt-no-agents"><i class="fas fa-triangle-exclamation"></i> {{noAgents}}</p>{{/if}}
        {{#if (or sendAgents.length sendPlaces.length)}}
        <div class="spt-agent-cards" role="radiogroup" aria-label="{{spt "Gm.Agents"}}">
          {{#each sendAgents}}<a class="spt-agent-card {{#if active}}active{{/if}} {{#if offline}}offline{{/if}}" data-action="sendTo" data-kind="agent" data-id="{{id}}" role="radio" title="{{name}}{{#if offline}} ({{spt "Gm.Offline"}}){{/if}}">{{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fas fa-user"></i>{{/if}}<span>{{name}}</span></a>{{/each}}
          {{#each sendPlaces}}<a class="spt-agent-card spt-place-card {{#if active}}active{{/if}} {{#if noLine}}noline{{/if}}" data-action="sendTo" data-kind="place" data-id="{{id}}" role="radio" title="{{name}}{{#if noLine}} ({{spt "Gm.NoLineShort"}}){{/if}}">{{#if img}}<img src="{{img}}" alt="">{{else}}<i class="fas fa-location-dot"></i>{{/if}}<span>{{#if noLine}}<i class="fas fa-phone-slash" title="{{spt "Gm.NoLineShort"}}"></i> {{else}}{{#if img}}<i class="fas fa-location-dot"></i> {{/if}}{{/if}}{{name}}</span></a>{{/each}}
        </div>
        {{/if}}
        <div class="spt-chips" role="radiogroup" aria-label="{{spt "Gm.OtherDevices"}}">
          {{#if (or targetDevices.length (eq sendKind "other"))}}<a class="spt-chip spt-chip-other {{#if (eq sendKind "other")}}active{{/if}}" data-action="sendTo" data-kind="other" role="radio">{{spt "Gm.OtherDevices"}}</a>{{/if}}
        </div>
        {{#if (eq sendKind "other")}}
        <div class="spt-icon-select"><i class="fas fa-mobile-screen"></i>
          <select name="target" data-icon-select>
            {{#each targetDevices}}<option value="{{value}}" data-icon="{{icon}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
          </select>
        </div>
        {{else}}
        {{#if sendTiles.length}}
        <div class="spt-tiles" role="radiogroup">
          {{#each sendTiles}}<a class="spt-tile {{#if selected}}active{{/if}} {{#if fresh}}fresh{{/if}}" data-action="pickDevice" data-target="{{target}}" role="radio"><i class="fas {{icon}}"></i><strong>{{label}}{{#if secure}} <i class="fas fa-shield-halved spt-secure"></i>{{/if}}{{#if satellite}} <i class="fas fa-satellite spt-sat-badge" title="{{spt "Satellite.Device"}}"></i>{{/if}}</strong><small>{{sub}}</small></a>{{/each}}
          {{#if (eq sendKind "agent")}}{{#unless createCard}}<a class="spt-tile spt-tile-add" data-action="addDevice" title="{{spt "Gm.AddDevice"}}" aria-label="{{spt "Gm.AddDevice"}}"><i class="fas fa-plus"></i></a>{{/unless}}{{/if}}
        </div>
        {{/if}}
        {{/if}}
        {{#if createdNote}}<p class="spt-created-note"><i class="fas fa-check"></i> {{createdNote}}</p>{{/if}}
      </div>
      {{#if createCard}}
      <div class="spt-quick-new">
        <strong>{{#if createCard.canCancel}}{{spt "Gm.AnotherDevice" name=createCard.name}}{{else}}{{spt "Gm.NoDeviceFor" name=createCard.name}}{{/if}}</strong>
        <small class="spt-dim">{{spt "Gm.QuickHint"}}</small>
        <div class="spt-quick-kinds">
          {{#each createCard.kinds}}<button type="button" class="spt-kind {{#if recommended}}recommended{{/if}}" data-action="quickCreate" data-kind="{{key}}" data-preview="{{drawLabel}} · {{drawNumber}}">{{#if recommended}}<span class="spt-quick-tag">{{spt "Gm.Recommended"}}</span>{{/if}}<img src="{{img}}" alt=""><b>{{label}}</b><small>{{caps}}</small></button>{{/each}}
        </div>
        <div class="spt-quick-preview"><a data-action="reroll" title="{{spt "Gm.Reroll"}}" aria-label="{{spt "Gm.Reroll"}}"><i class="fas fa-dice"></i></a> <span data-quick-preview>{{spt "Gm.QuickPreview"}}</span></div>
        {{#if createCard.showPub}}<label class="spt-quick-pub"><input type="checkbox" name="newPub" {{#if createCard.pub}}checked{{/if}}> {{spt "Gm.NewDevicePublic"}}</label>{{/if}}
        <div class="spt-quick-links">
          {{#if createCard.canCancel}}<a data-action="cancelAdd">{{spt "Cancel"}}</a>{{/if}}
          <a data-action="moreOptions">{{spt "Gm.MoreOptions"}}</a>
        </div>
      </div>
      {{else if lineCard}}
      <div class="spt-quick-new spt-quick-line">
        <strong>{{spt "Gm.NoLineAt" name=lineCard.name}}</strong>
        {{#if lineCard.present}}<small class="spt-dim">{{spt "Gm.PresentHere" names=lineCard.present}}</small>{{/if}}
        <div class="spt-quick-line-row">
          <img src="{{lineCard.img}}" alt="">
          <span class="spt-quick-preview">{{lineCard.label}} · {{lineCard.number}} <a data-action="rerollLine" title="{{spt "Gm.Reroll"}}" aria-label="{{spt "Gm.Reroll"}}"><i class="fas fa-dice"></i></a></span>
          <button type="button" class="spt-primary" data-action="quickLine"><i class="fas fa-plus"></i> {{spt "Gm.InstallLine"}}</button>
        </div>
      </div>
      {{else}}
      <div class="form-group">
        <label>{{spt "Gm.Sender"}}</label>
        <input type="text" name="sender" value="{{sender}}" placeholder="{{spt "Masked"}}" list="spt-senders" autocomplete="off" data-known="{{knownSenders}}">
        <datalist id="spt-senders">{{#each senderOptions}}<option value="{{value}}" label="{{label}}"></option>{{/each}}</datalist>
      </div>
      <div class="spt-sender-extra">
        {{#each pinnedSenders}}<a class="spt-chip spt-chip-npc {{#if active}}active{{/if}}" data-action="pickSender" data-value="{{value}}"><i class="fas fa-star"></i> {{label}}</a>{{/each}}
        <label class="spt-add-dir" hidden><input type="checkbox" name="addToDir" {{#if addToDir}}checked{{/if}}> {{spt "Directory.AddSender"}}</label>
      </div>

      {{#if messaging}}
      <div class="spt-segmented" role="radiogroup">
        <a class="{{#if (eq mode "message")}}active{{/if}}" data-action="mode" data-mode="message" role="radio"><i class="fas fa-comment-sms"></i> {{spt "Gm.ModeMessage"}}</a>
        <a class="{{#if (eq mode "call")}}active{{/if}}" data-action="mode" data-mode="call" role="radio"><i class="fas fa-phone"></i> {{spt "Gm.ModeCall"}}</a>
      </div>
      {{/if}}

      {{#if (eq mode "message")}}
      <div class="spt-drop" title="{{spt "DropHere"}}">
        {{{attChip}}}
        <textarea name="text" rows="5" placeholder="{{spt "Gm.MessagePlaceholder"}}">{{text}}</textarea>
      </div>
      <p class="spt-drop-hint"><i class="fas fa-file-import"></i> {{spt "Gm.DropJournal"}}</p>
      <div class="spt-phone-row">
        <button type="button" class="spt-icon-btn" data-action="attach" title="{{spt "AttachImage"}}" aria-label="{{spt "AttachImage"}}"><i class="fas fa-paperclip"></i></button>
        <button type="button" class="spt-icon-btn" data-action="copyLink" title="{{spt "Gm.CopyLink"}}" aria-label="{{spt "Gm.CopyLink"}}"><i class="fas fa-link"></i></button>
        {{#if canSecure}}<button type="button" class="spt-icon-btn spt-secure-link" data-action="copySecureLink" title="{{spt "Secure.CopyLink"}}" aria-label="{{spt "Secure.CopyLink"}}"><i class="fas fa-link"></i><i class="fas fa-shield-halved"></i></button>{{/if}}
        <button type="button" class="spt-primary" data-action="sms"><i class="fas fa-paper-plane"></i> {{#if targetName}}{{spt "Gm.SendTo" name=targetName}}{{else}}{{spt "Send"}}{{/if}}{{#if viaSat}} <i class="fas fa-satellite spt-sat-btn" title="{{spt "Satellite.Signal"}}"></i>{{/if}}</button>
        {{#if canSecure}}<button type="button" class="spt-primary spt-secure-btn" data-action="smsSecure" title="{{spt "Secure.BoxHint"}}"><i class="fas fa-shield-halved"></i> {{spt "Secure.Send"}}{{#if viaSat}} <i class="fas fa-satellite spt-sat-btn" title="{{spt "Satellite.Signal"}}"></i>{{/if}}</button>{{/if}}
      </div>
      {{else}}
      <div class="spt-phone-row">
        <button type="button" class="spt-icon-btn" data-action="copyLink" title="{{spt "Gm.CopyLink"}}" aria-label="{{spt "Gm.CopyLink"}}"><i class="fas fa-link"></i></button>
        {{#if canSecure}}<button type="button" class="spt-icon-btn spt-secure-link" data-action="copySecureLink" title="{{spt "Secure.CopyLink"}}" aria-label="{{spt "Secure.CopyLink"}}"><i class="fas fa-link"></i><i class="fas fa-shield-halved"></i></button>{{/if}}
        <button type="button" class="spt-primary" data-action="ring"><i class="fas fa-phone-volume"></i> {{#if targetName}}{{spt "Gm.RingTo" name=targetName}}{{else}}{{spt "Gm.Ring"}}{{/if}}{{#if viaSat}} <i class="fas fa-satellite spt-sat-btn" title="{{spt "Satellite.Signal"}}"></i>{{/if}}</button>
        {{#if canSecure}}<button type="button" class="spt-primary spt-secure-btn" data-action="ringSecure" title="{{spt "Secure.BoxHint"}}"><i class="fas fa-shield-halved"></i> {{spt "Secure.Ring"}}{{#if viaSat}} <i class="fas fa-satellite spt-sat-btn" title="{{spt "Satellite.Signal"}}"></i>{{/if}}</button>{{/if}}
      </div>
      {{/if}}
      {{/if}}
    </section>
  {{/if}}

  {{#if (eq tab "inbox")}}
    <section class="spt-gm-inbox">
      {{#if showMarkAll}}<a class="spt-mark-all spt-mark-all-top" data-action="markAllSeen"><i class="fas fa-check-double"></i> {{spt "Gm.MarkAllSeen"}}</a>{{/if}}
      {{#if inboxAgents.length}}
      <div class="spt-chips">
        <a class="spt-chip {{#if inboxAllAgents}}active{{/if}}" data-action="filterAgent" data-agent="">{{spt "Gm.All"}}</a>
        {{#each inboxAgents}}<a class="spt-chip {{#if active}}active{{/if}}" data-action="filterAgent" data-agent="{{id}}">{{#if img}}<img src="{{img}}" alt="">{{/if}}{{name}}{{#if unread}} <span class="spt-badge">{{unread}}</span>{{/if}}</a>{{/each}}
      </div>
      {{/if}}
      {{#if pinned.length}}
      <div class="spt-chips">
        {{#each pinned}}<a class="spt-chip spt-chip-npc {{#if active}}active{{/if}}" data-action="filterNpc" data-npc="{{id}}"><i class="fas fa-star"></i> {{name}}{{#if unread}} <span class="spt-badge">{{unread}}</span>{{/if}}</a>{{/each}}
      </div>
      {{/if}}
      {{#if npcFocus}}
      <div class="spt-npc-focus">
        <strong>{{npcFocus.name}}</strong>{{#if npcFocus.number}} <small class="spt-dim">{{npcFocus.number}}</small>{{/if}}
        <a class="spt-npc-close" data-action="filterNpc" data-npc="" title="{{spt "Gm.All"}}"><i class="fas fa-xmark"></i></a>
        <div class="spt-chips"><span class="spt-dim">{{spt "Gm.WriteAs" name=npcFocus.name}}</span>
          {{#each npcFocus.agents}}<a class="spt-chip" data-action="writeAs" data-user="{{id}}" data-sender="{{../npcFocus.sender}}">{{#if img}}<img src="{{img}}" alt="">{{/if}}{{name}}</a>{{/each}}
        </div>
      </div>
      {{/if}}
      {{#if inbox.length}}
      <div class="spt-gthreads">
        {{#each inbox}}
        <div class="spt-gthread {{#if unread}}unread{{/if}} {{#if agents}}agents{{/if}}" data-thread="{{id}}" data-uuid="{{uuid}}" data-key="{{key}}">
          <div class="spt-gthread-head">{{#if agents}}<i class="fas fa-headphones spt-dim" title="{{spt "Gm.BetweenAgents"}}"></i> {{/if}}<i class="fas {{channel}} spt-dim spt-channel" title="{{channelLabel}}"></i> <strong>{{who}}</strong>{{#if compromised}} <i class="fas fa-triangle-exclamation spt-compromised" title="{{spt "Gm.Compromised"}}"></i>{{/if}} <i class="fas fa-arrow-right" aria-hidden="true"></i> {{#if agents}}{{#each others}}{{#unless @first}}, {{/unless}}{{#if icon}}<i class="fas {{icon}} spt-dim" title="{{modelLabel}}"></i> {{/if}}{{name}}{{/each}}{{else}}<a class="spt-npc-link" data-action="filterNpc" data-npc="{{npcId}}" title="{{spt "Gm.FilterNpc"}}">{{#if pinned}}<i class="fas fa-star spt-star"></i> {{/if}}{{to}}</a>{{#if addr}} <span class="spt-addr">{{addr}}</span>{{/if}}{{/if}}{{#if canSecure}} <a data-action="toggleSecureWith" class="spt-secure-toggle {{#if secure}}on{{/if}}" title="{{#if secure}}{{spt "Secure.On"}}{{else}}{{spt "Secure.Off"}}{{/if}}"><i class="fas fa-shield-halved"></i></a>{{else if secure}} <i class="fas fa-shield-halved spt-secure" title="{{spt "Secure.Line"}}"></i>{{/if}}{{#if unknown}} <span class="spt-unknown-pill">? {{spt "Directory.Unknown"}}</span>{{/if}}{{#if unread}} <span class="spt-badge">{{unread}}</span>{{/if}}</div>
          {{#if more}}<div class="spt-gthread-more">…</div>{{/if}}
          {{#each bubbles}}
          <div class="spt-bb {{dir}} {{#if pending}}pending{{/if}}">{{#if secure}}<i class="fas fa-shield-halved spt-secure spt-bb-secure" title="{{spt "Secure.Message"}}"></i>{{/if}}{{#if fwd}}<span class="spt-bb-fwd"><i class="fas fa-share"></i> {{spt "Fwd.Forwarded"}}</span>{{/if}}{{{att}}}{{#if text}}<div>{{{text}}}</div>{{/if}}{{#if ago}}<small class="spt-bb-ago" title="{{when}}">{{ago}}</small>{{/if}}</div>
          {{/each}}
          {{#if unknown}}
          <div class="spt-unknown-box" data-unknown="{{key}}">
            <div><i class="fas fa-circle-question"></i> {{spt "Directory.UnknownHint"}}</div>
            <div class="spt-gthread-reply">
              <input type="text" data-unknown-name placeholder="{{spt "Directory.WhoAnswers"}}" aria-label="{{spt "Directory.WhoAnswers"}}" autocomplete="off">
              <button type="button" class="spt-text-btn" data-action="nameNumber">{{spt "Directory.Name"}}</button>
              <button type="button" class="spt-text-btn" data-action="offNumber" title="{{spt "Directory.OffHint"}}"><i class="fas fa-ban"></i> {{spt "Directory.Off"}}</button>
            </div>
          </div>
          {{/if}}
          {{#unless agents}}
          <div class="spt-reply-drop" title="{{spt "DropHere"}}">
          {{{attChip}}}
          <div class="spt-gthread-reply">
            <input type="text" data-draft="{{id}}" value="{{draft}}" placeholder="{{spt "Gm.ReplyAs" name=to}}" aria-label="{{spt "Gm.ReplyAs" name=to}}">
            <button type="button" data-action="sendReply" aria-label="{{spt "Send"}}" data-tooltip="{{spt "Send"}}"><i class="fas fa-paper-plane"></i>{{#if viaSat}} <i class="fas fa-satellite spt-sat-btn" title="{{spt "Satellite.Signal"}}"></i>{{/if}}</button>
            {{#if canCall}}<button type="button" data-action="callBack" aria-label="{{spt "Gm.CallBack"}}" data-tooltip="{{spt "Gm.CallBack"}}"><i class="fas fa-phone"></i>{{#if viaSat}} <i class="fas fa-satellite spt-sat-btn" title="{{spt "Satellite.Signal"}}"></i>{{/if}}</button>{{/if}}
          </div>
          </div>
          {{/unless}}
        </div>
        {{/each}}
      </div>
      {{#if moreThreads}}<a class="spt-mark-all" data-action="moreThreads">{{spt "Gm.ShowMore"}}</a>{{/if}}
      {{else}}
      <p class="spt-phone-status">{{spt "Gm.NoInbox"}}</p>
      {{/if}}
    </section>
  {{/if}}

  {{#if (eq tab "watch")}}
    <section class="spt-gm-watch">
      <div class="spt-segmented" role="radiogroup">
        <a class="{{#if (eq watch.view "listen")}}active{{/if}}" data-action="watchView" data-view="listen" role="radio" title="{{spt "Gm.BetweenAgents"}}"><i class="fas fa-headphones"></i> {{spt "Gm.InboxAgents"}}{{#if listenNew}} <span class="spt-count">{{listenNew}}</span>{{/if}}</a>
        <a class="{{#if (eq watch.view "calls")}}active{{/if}}" data-action="watchView" data-view="calls" role="radio"><i class="fas fa-phone"></i> {{spt "Calls.Tab"}}</a>
        {{#if feat.tracking}}<a class="{{#if (eq watch.view "tracking")}}active{{/if}}" data-action="watchView" data-view="tracking" role="radio" title="{{spt "Track.Hint"}}"><i class="fas fa-location-crosshairs"></i> {{spt "Gm.TabTracking"}}</a>{{/if}}
      </div>
      <div class="spt-chips">
        <a class="spt-chip {{#if watch.allAgents}}active{{/if}}" data-action="watchAgent" data-agent="">{{spt "Gm.All"}}</a>
        {{#each watch.agents}}<a class="spt-chip {{#if active}}active{{/if}}" data-action="watchAgent" data-agent="{{id}}">{{#if img}}<img src="{{img}}" alt="">{{/if}}{{name}}</a>{{/each}}
        <a class="spt-chip spt-leak {{#if watch.leak}}active{{/if}}" data-action="watchLeak" title="{{spt "Gm.LeakHint"}}"><i class="fas fa-triangle-exclamation"></i> {{spt "Gm.Leak"}}</a>
      </div>
      {{#if (eq watch.view "listen")}}
      {{#if watch.threads.length}}
      <div class="spt-gthreads">
        {{#each watch.threads}}
        <div class="spt-gthread agents" data-thread="{{id}}">
          <div class="spt-gthread-head"><i class="fas {{icon}} spt-dim" title="{{modelLabel}}"></i> <strong>{{who}}</strong>{{#if compromised}} <i class="fas fa-triangle-exclamation spt-compromised" title="{{spt "Gm.Compromised"}}"></i>{{/if}} <i class="fas fa-arrow-right" aria-hidden="true"></i> {{#each others}}{{#unless @first}}, {{/unless}}{{#if icon}}<i class="fas {{icon}} spt-dim" title="{{modelLabel}}"></i> {{/if}}{{name}}{{/each}}{{#if secure}} <i class="fas fa-shield-halved spt-secure" title="{{spt "Secure.Line"}}"></i>{{/if}}</div>
          {{#if more}}<div class="spt-gthread-more">…</div>{{/if}}
          {{#each bubbles}}
          <div class="spt-bb {{dir}} {{#if pending}}pending{{/if}}">{{#if secure}}<i class="fas fa-shield-halved spt-secure spt-bb-secure" title="{{spt "Secure.Message"}}"></i>{{/if}}{{#if fwd}}<span class="spt-bb-fwd"><i class="fas fa-share"></i> {{spt "Fwd.Forwarded"}}</span>{{/if}}{{{att}}}{{#if text}}<div>{{{text}}}</div>{{/if}}</div>
          {{/each}}
        </div>
        {{/each}}
      </div>
      {{#if watch.more}}<a class="spt-mark-all" data-action="moreThreads">{{spt "Gm.ShowMore"}}</a>{{/if}}
      {{else}}
      <p class="spt-phone-status">{{spt "Gm.NoListen"}}</p>
      {{/if}}
      {{/if}}
      {{#if (eq watch.view "calls")}}
      {{#if watch.calls.length}}
      {{#each watch.calls}}
      <h4 class="spt-call-when">{{label}}</h4>
      <ul class="spt-call-list">
        {{#each rows}}
        <li class="spt-call-row {{#if answered}}answered{{/if}} {{#if live}}live{{/if}}">
          <i class="fas {{#if answered}}fa-phone{{else}}fa-phone-slash{{/if}} spt-call-icon"></i>
          <span class="spt-call-who">{{#unless fromAgent}}<i class="fas fa-user-secret spt-dim" title="{{spt "Calls.FromGm"}}"></i> {{/unless}}{{from}} <i class="fas fa-arrow-right" aria-hidden="true"></i> {{to}}{{#if compromised}} <i class="fas fa-triangle-exclamation spt-compromised" title="{{spt "Gm.Compromised"}}"></i>{{/if}}{{#if secure}} <i class="fas fa-shield-halved spt-secure" title="{{spt "Secure.Line"}}"></i>{{/if}}</span>
          {{#if live}}
          <span class="spt-call-res spt-call-live"><i class="fas fa-circle"></i> {{spt "Live.OnLine"}} {{{live}}}</span>
          {{else}}
          <span class="spt-call-res">{{result}}{{#if dur}} <span class="spt-call-dur">{{dur}}</span>{{/if}}</span>
          {{/if}}
        </li>
        {{/each}}
      </ul>
      {{/each}}
      {{else}}
      <p class="spt-phone-status">{{spt "Calls.None"}}</p>
      {{/if}}
      {{/if}}
      {{#if (eq watch.view "tracking")}}
      <p class="spt-track-hint"><span class="spt-exp-tag"><i class="fas fa-flask"></i> {{spt "Track.Experimental"}}</span> {{spt "Track.Hint"}}</p>
      {{#each watch.tracking}}
      <div class="spt-dev-group spt-track-group">
        <header class="spt-dev-group-head">
          {{#if img}}<img src="{{img}}" alt="">{{/if}}
          <strong>{{agent}}</strong>
          {{#if location}}<span class="spt-track-scene"><i class="fas fa-question"></i> {{location}}</span>{{/if}}
          <span class="spt-track-level spt-track-{{level}}">{{levelLabel}}</span>
        </header>
        {{#if lastCall}}<div class="spt-track-call" title="{{spt "Track.LastCall"}}"><i class="fas fa-phone"></i> {{lastCall}}</div>{{/if}}
        {{#if devices.length}}
        <ul class="spt-dev-list">
          {{#each devices}}
          <li class="spt-dev spt-track">
            <i class="fas {{icon}}" title="{{modelLabel}}"></i>
            <span class="spt-dev-label">{{label}}{{#if compromised}} <i class="fas fa-triangle-exclamation spt-compromised" title="{{spt "Gm.Compromised"}}"></i>{{/if}}{{#if secure}} <i class="fas fa-shield-halved spt-secure" title="{{spt "Secure.Device"}}"></i>{{/if}}</span>
            <span class="spt-track-small">{{levelLabel}}</span>
          </li>
          {{/each}}
        </ul>
        {{/if}}
      </div>
      {{else}}
      <p class="spt-phone-status">{{spt "Track.None"}}</p>
      {{/each}}
      {{/if}}
    </section>
  {{/if}}

  {{#if (eq tab "directory")}}
    <section class="spt-gm-directory">
      <p class="spt-dir-intro"><i class="fas fa-circle-info"></i> {{spt "Directory.Intro"}}</p>
      <p class="spt-dir-legend"><i class="fas fa-star spt-dev-pin"></i> {{spt "Directory.LegendPin"}} · <span class="spt-dir-flag on pub">{{spt "Directory.Public"}}</span> {{spt "Directory.LegendPublic"}}</p>
      {{#if directory.unknown.length}}
      <h4 class="spt-call-when">{{spt "Directory.ToIdentify"}}</h4>
      <ul class="spt-dir-list">
        {{#each directory.unknown}}
        <li class="spt-dir-row" data-unknown="{{key}}">
          <span class="spt-dir-num">{{key}}</span>
          <input type="text" data-unknown-name placeholder="{{spt "Directory.WhoAnswers"}}" aria-label="{{spt "Directory.WhoAnswers"}}" autocomplete="off">
          <small class="spt-dim">{{who}} · {{count}}</small>
          <a class="spt-dir-act" data-action="nameNumber" title="{{spt "Directory.Name"}}"><i class="fas fa-check"></i></a>
          <a class="spt-dir-act" data-action="offNumber" title="{{spt "Directory.OffHint"}}"><i class="fas fa-ban"></i></a>
        </li>
        {{/each}}
      </ul>
      {{/if}}
      <fieldset class="spt-dir-add">
        <legend><i class="fas fa-user-plus"></i> {{spt "Directory.NewNpc"}}</legend>
        <div class="spt-dir-add-row">
          <input type="text" name="dirName" value="{{directory.name}}" placeholder="{{spt "Directory.NamePlaceholder"}}" aria-label="{{spt "Directory.NamePlaceholder"}}" autocomplete="off">
          <label title="{{spt "Directory.PinHint"}}"><input type="checkbox" name="dirPinNew" {{#if directory.pin}}checked{{/if}}> <i class="fas fa-star"></i></label>
          <label title="{{spt "Directory.PublicHint"}}"><input type="checkbox" name="dirPubNew" {{#if directory.pub}}checked{{/if}}> {{spt "Directory.Public"}}</label>
          <button type="button" class="spt-primary" data-action="dirAdd" aria-label="{{spt "Directory.Add"}}" title="{{spt "Directory.Add"}}"><i class="fas fa-plus"></i> {{spt "Directory.AddShort"}}</button>
        </div>
        <p class="spt-dim spt-dir-auto"><i class="fas fa-wand-magic-sparkles"></i> {{spt "Directory.AutoNumber"}}</p>
      </fieldset>
      <div class="spt-dir-search"><i class="fas fa-magnifying-glass"></i><input type="search" name="dirSearch" value="{{directory.search}}" placeholder="{{spt "Directory.Search"}}" aria-label="{{spt "Directory.Search"}}" autocomplete="off"></div>
      <ul class="spt-dir-list spt-dir-devhits">
        {{#each directory.devices}}
        <li class="spt-dir-devhit" data-device-hit="{{search}}" hidden><i class="fas fa-mobile-screen spt-dim"></i> {{spt "Directory.DeviceHit" number=number name=name}} <a data-action="switchTab" data-tab="devices">{{spt "Directory.SeeDevices"}} <i class="fas fa-arrow-right"></i></a></li>
        {{/each}}
      </ul>
      <h4 class="spt-call-when">{{spt "Directory.NpcTitle"}}</h4>
      <ul class="spt-dir-list">
        {{#each directory.rows}}
        {{#if title}}
        <li class="spt-dir-section">{{title}}</li>
        {{else if editing}}
        <li class="spt-dir-row editing" data-line="{{line}}">
          <input type="text" name="dirEditNumber" value="{{number}}" placeholder="{{spt "Number"}}" class="spt-dir-num" autocomplete="off">
          <input type="text" name="dirEditName" value="{{name}}" placeholder="{{spt "Directory.NamePlaceholder"}}" autocomplete="off">
          <a class="spt-dir-act" data-action="dirSave" title="{{spt "Save"}}"><i class="fas fa-check"></i></a>
          <a class="spt-dir-act" data-action="dirCancel" title="{{spt "Cancel"}}"><i class="fas fa-xmark"></i></a>
        </li>
        {{else}}
        <li class="spt-dir-row {{#if off}}off{{/if}}" data-line="{{line}}" data-search="{{search}}">
          <span class="spt-dir-num">{{#if number}}{{number}}{{else}}—{{/if}}</span>
          <a class="spt-dir-star {{#if pin}}on{{/if}}" data-action="dirPin" title="{{spt "Directory.PinHint"}}"><i class="fa{{#if pin}}s{{else}}r{{/if}} fa-star"></i></a>
          <a class="spt-dir-name" data-action="dirEdit" title="{{spt "Gm.Edit"}}">{{#if unnamed}}<span class="spt-dim">—</span>{{else}}{{name}}{{/if}}</a>
          {{#if who}}<a class="spt-dir-act" data-action="filterNpc" data-npc="{{npcId}}" title="{{spt "Directory.OpenMessages"}}"><i class="fas fa-comments"></i></a>{{/if}}
          <a class="spt-dir-flag {{#if pub}}on pub{{/if}}" data-action="dirPub" title="{{spt "Directory.PublicHint"}}">{{spt "Directory.Public"}}</a>
          <a class="spt-dir-flag {{#if off}}on off{{/if}}" data-action="dirOff" title="{{spt "Directory.OffHint"}}">{{spt "Directory.Off"}}</a>
          <small class="spt-dim spt-dir-who">{{who}}</small>
          <a class="spt-dir-act" data-action="dirDelete" title="{{spt "Delete"}}"><i class="fas fa-trash"></i></a>
        </li>
        {{/if}}
        {{else}}
        <li class="spt-phone-status">{{spt "Directory.Empty"}}</li>
        {{/each}}
      </ul>
      {{#if directory.off.length}}
      <details class="spt-dir-off" {{#if directory.offOpen}}open{{/if}}>
      <summary class="spt-call-when">{{spt "Directory.OffTitle"}} ({{directory.off.length}}) <small class="spt-dir-sub">{{spt "Directory.OffSectionHint"}}</small></summary>
      <ul class="spt-dir-list">
        {{#each directory.off}}
        <li class="spt-dir-row off" data-line="{{line}}" data-search="{{search}}">
          <span class="spt-dir-num">{{#if number}}{{number}}{{else}}—{{/if}}</span>
          <a class="spt-dir-name" data-action="dirEdit" title="{{spt "Gm.Edit"}}">{{#if unnamed}}<span class="spt-dim">—</span>{{else}}{{name}}{{/if}}</a>
          <small class="spt-dim spt-dir-who">{{who}}</small>
          <a class="spt-dir-flag on off" data-action="dirOff" title="{{spt "Directory.OffBack"}}">{{spt "Directory.Off"}}</a>
          <a class="spt-dir-act" data-action="dirDelete" title="{{spt "Delete"}}"><i class="fas fa-trash"></i></a>
        </li>
        {{/each}}
      </ul>
      </details>
      {{/if}}
      <p class="spt-dir-foot"><span class="spt-dim">{{spt "Directory.NoPrep"}}</span> <a class="spt-dir-io" data-action="directory"><i class="fas fa-file-import"></i> {{spt "Directory.EditText"}}</a></p>
    </section>
  {{/if}}

  {{#if (eq tab "devices")}}
    <section class="spt-gm-devices">
      {{#if (gt devFilters.length 2)}}<div class="spt-fx-bar"><span class="spt-fx-pick" role="radiogroup">{{#each devFilters}}<a data-action="devFilter" data-filter="{{key}}" class="{{#if active}}active{{/if}}" role="radio">{{label}} <small>{{n}}</small></a>{{/each}}</span></div>{{/if}}
      {{#each groups}}
      <div class="spt-dev-group">
        <header class="spt-dev-group-head">
          {{#if img}}<img src="{{img}}" alt="">{{else}}<span class="spt-dev-avatar"><i class="fas {{icon}}"></i></span>{{/if}}
          <strong>{{name}}</strong>
        </header>
        <ul class="spt-dev-list">
          {{#each devices}}
          <li class="spt-dev">
            {{#if jammer}}
            <a class="spt-dev-main" data-action="openPhone" data-uuid="{{uuid}}" title="{{spt "Jammer.Open"}}">
              <i class="fas {{icon}} {{#if jamOn}}spt-jamming{{/if}}" title="{{modelLabel}}"></i>
              <span class="spt-dev-label">{{label}}</span>
              {{#if jamOn}}<span class="spt-jam-state on">{{spt "Jammer.StateOn"}}</span>{{/if}}
              {{#if jamFailed}}<span class="spt-jam-state">{{spt "Jammer.StateFailed"}}</span>{{/if}}
            </a>
            {{else}}
            <a class="spt-dev-main" data-action="selectPhone" data-uuid="{{uuid}}" title="{{#if npcHeld}}{{spt "Gm.PickSender"}}{{else}}{{spt "Gm.PickRecipient"}}{{/if}}">
              <i class="fas {{icon}}" title="{{modelLabel}}"></i>
              <span class="spt-dev-label">{{label}} <small>{{number}}</small></span>
              {{#if modeIcon}}<i class="fas {{modeIcon}} spt-dim" title="{{modeLabel}}"></i>{{/if}}
              {{#if locked}}<i class="fas fa-lock spt-warn spt-dev-state" title="{{spt "Gm.Locked"}}"></i>{{/if}}
              {{#if secure}}<i class="fas fa-shield-halved spt-secure spt-dev-state" title="{{spt "Secure.Device"}}"></i>{{/if}}
              {{#if satellite}}<i class="fas fa-satellite spt-sat-badge spt-dev-state" title="{{spt "Satellite.Device"}}"></i>{{/if}}
              {{#if compromised}}<i class="fas fa-triangle-exclamation spt-compromised spt-dev-state" title="{{spt "Gm.Compromised"}}"></i>{{/if}}
              {{#if noSignal}}<i class="fas fa-signal spt-nosignal spt-dev-state" title="{{spt "Gm.NoSignal"}}"></i>{{/if}}
              {{#if cloned}}<i class="fas fa-clone spt-warn" title="{{spt "Gm.ClonedHint"}}"></i>{{/if}}
              {{#if unread}}<span class="spt-row-unread" title="{{unreadTitle}}"><i class="fas fa-envelope"></i> {{unread}}</span>{{/if}}
              {{#if pin}}<span class="spt-dev-pin" data-action="devPin" data-uuid="{{uuid}}" title="{{spt "Directory.DevicePinHint"}}"><i class="fas fa-star"></i></span>{{/if}}
              {{#if pub}}<span class="spt-dev-pub" data-action="devPub" data-uuid="{{uuid}}" title="{{spt "Directory.DevicePublicHint"}}">{{spt "Directory.Public"}}</span>{{/if}}
            </a>
            {{#if filter}}<a class="spt-dev-msgs" data-action="filterDevice" {{#if filter.agent}}data-agent="{{filter.agent}}"{{/if}} {{#if filter.npc}}data-npc="{{filter.npc}}"{{/if}} title="{{spt "Directory.OpenMessages"}}" aria-label="{{spt "Directory.OpenMessages"}}"><i class="fas fa-comments"></i></a>{{/if}}
            {{/if}}
            <span class="spt-dev-actions" aria-label="{{spt "Gm.Actions"}}">
              <a data-action="openPhone" data-uuid="{{uuid}}" title="{{spt "Gm.OpenPrepare"}}" aria-label="{{spt "Gm.OpenPrepare"}}"><i class="fas fa-pen-to-square"></i></a>
              {{#unless jammer}}
              <a data-action="toggleLock" data-uuid="{{uuid}}" class="{{#if locked}}spt-locked{{/if}}" title="{{#if locked}}{{spt "Gm.Locked"}}{{else}}{{spt "Gm.Unlocked"}}{{/if}}" aria-label="{{#if locked}}{{spt "Gm.Locked"}}{{else}}{{spt "Gm.Unlocked"}}{{/if}}"><i class="fas {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i></a>
              <a data-action="toggleCompromised" data-uuid="{{uuid}}" class="{{#if compromised}}spt-compromised{{/if}}" title="{{#if compromised}}{{spt "Gm.Compromised"}}{{else}}{{spt "Gm.NotCompromised"}}{{/if}}" aria-label="{{#if compromised}}{{spt "Gm.Compromised"}}{{else}}{{spt "Gm.NotCompromised"}}{{/if}}"><i class="fas fa-triangle-exclamation"></i></a>
              {{#unless fixed}}<a data-action="toggleSignal" data-uuid="{{uuid}}" class="{{#if noSignal}}spt-nosignal{{/if}}" title="{{#if noSignal}}{{spt "Gm.NoSignal"}}{{else}}{{spt "Gm.SignalOk"}}{{/if}}" aria-label="{{#if noSignal}}{{spt "Gm.NoSignal"}}{{else}}{{spt "Gm.SignalOk"}}{{/if}}"><i class="fas fa-signal"></i></a>{{/unless}}
              <a data-action="contacts" data-uuid="{{uuid}}" title="{{spt "Contacts.Title"}}" aria-label="{{spt "Contacts.Title"}}"><i class="fas fa-address-book"></i></a>
              {{#if canPin}}<a data-action="devPin" data-uuid="{{uuid}}" class="{{#if pin}}spt-pinned{{/if}}" title="{{spt "Directory.DevicePinHint"}}" aria-label="{{spt "Directory.DevicePinHint"}}"><i class="fa{{#if pin}}s{{else}}r{{/if}} fa-star"></i></a>{{/if}}
              {{#if number}}<a data-action="devPub" data-uuid="{{uuid}}" class="{{#if pub}}spt-public{{/if}}" title="{{spt "Directory.DevicePublicHint"}}" aria-label="{{spt "Directory.DevicePublicHint"}}"><i class="fas fa-globe"></i></a>{{/if}}
              {{/unless}}
              {{#unless fixed}}<a data-action="give" data-uuid="{{uuid}}" title="{{spt "Gm.GiveTo"}}" aria-label="{{spt "Gm.GiveTo"}}"><i class="fas fa-hand-holding"></i></a>{{/unless}}
              <a data-action="editPhone" data-uuid="{{uuid}}" title="{{spt "Gm.Edit"}}" aria-label="{{spt "Gm.Edit"}}"><i class="fas fa-gear"></i></a>
              <a data-action="unmarkPhone" data-uuid="{{uuid}}" title="{{spt "Gm.Remove"}}" aria-label="{{spt "Gm.Remove"}}"><i class="fas fa-trash"></i></a>
            </span>
          </li>
          {{/each}}
        </ul>
      </div>
      {{else}}
      <p class="spt-phone-status">{{spt "Gm.NoDevices"}}</p>
      {{/each}}
      <p class="spt-dev-legend"><span><i class="fas fa-star spt-dev-pin"></i> {{spt "Gm.LegendPin"}}</span> <span><span class="spt-dev-pub">{{spt "Directory.Public"}}</span> {{spt "Gm.LegendPublic"}}</span> <span><i class="fas fa-lock spt-warn"></i> {{spt "Gm.LegendLock"}}</span></p>
    </section>
  {{/if}}
  {{#if (eq tab "files")}}
    <section class="spt-gm-files">
      {{#if files.noFiles}}<p class="spt-fx-intro"><i class="fas fa-circle-info"></i> {{spt "Files.Intro"}}</p>{{/if}}
      {{#if files.hasComputers}}
      <div class="spt-segmented spt-fx-view" role="radiogroup" aria-label="{{spt "Files.GroupBy"}}">
        <a data-action="filesView" data-view="device" class="{{#if (eq files.view "device")}}active{{/if}}" role="radio"><i class="fas fa-desktop"></i> {{spt "Files.ByDevice"}}</a>
        <a data-action="filesView" data-view="journal" class="{{#if (eq files.view "journal")}}active{{/if}}" role="radio"><i class="fas fa-book"></i> {{spt "Files.ByJournal"}}</a>
      </div>
      <div class="spt-fx-bar">
        <span class="spt-fx-pick">
          {{#each files.filters}}<a data-action="filesFilter" data-filter="{{key}}" class="{{#if active}}active{{/if}}" title="{{label}}" aria-label="{{label}}">{{#if icon}}<i class="fas {{icon}}"></i>{{else}}{{label}}{{/if}} <small>{{n}}</small></a>{{/each}}
        </span>
        <input type="search" name="filesQuery" value="{{files.query}}" placeholder="{{spt "Files.Search"}}" aria-label="{{spt "Files.Search"}}" autocomplete="off">
      </div>
      {{#each files.groups}}
      <div class="spt-dev-group spt-fx-group" {{#if journal}}data-refs="{{refs}}"{{/if}}>
        <header class="spt-dev-group-head">
          {{#if img}}<img src="{{img}}" alt="">{{else}}<span class="spt-dev-avatar"><i class="fas {{icon}}"></i></span>{{/if}}
          <span class="spt-fx-title"><strong>{{name}}</strong><small>{{sub}}</small></span>
          {{#if journal}}{{#if bulk}}
          <a class="spt-fx-pill" data-action="groupState" data-state="visible" title="{{spt "Files.RevealAll"}}"><i class="fas fa-eye"></i> {{spt "Files.All"}}</a>
          <a class="spt-fx-pill" data-action="groupState" data-state="hidden" title="{{spt "Files.HideAll"}}"><i class="fas fa-eye-slash"></i> {{spt "Files.All"}}</a>
          {{/if}}{{else}}
          <a class="spt-fx-pill {{#if locked}}warn{{/if}}" data-action="toggleLock" data-uuid="{{uuid}}" title="{{#if locked}}{{spt "Gm.Locked"}}{{else}}{{spt "Gm.Unlocked"}}{{/if}}"><i class="fas {{#if locked}}fa-lock{{else}}fa-lock-open{{/if}}"></i> {{#if locked}}{{spt "Files.DevLocked"}}{{else}}{{spt "Files.DevOpen"}}{{/if}}</a>
          <a class="spt-fx-pill {{#unless (eq inbox "on")}}warn{{/unless}}" data-action="cycleInbox" data-uuid="{{uuid}}" data-inbox="{{inbox}}" title="{{spt "Form.Inbox"}}"><i class="fas {{inboxIcon}}"></i> {{inboxLabel}}</a>
          <a class="spt-fx-open" data-action="openPhone" data-uuid="{{uuid}}" title="{{spt "Gm.OpenPrepare"}}" aria-label="{{spt "Gm.OpenPrepare"}}"><i class="fas fa-pen-to-square"></i></a>
          {{/if}}
        </header>
        <ul class="spt-fx-files">
          {{#each files}}
          <li class="spt-fx-file spt-fx-{{state}}" data-file="{{id}}" data-uuid="{{uuid}}" {{#if mail}}data-mail="1"{{/if}} data-search="{{name}} {{device}} {{who}}">
            <i class="fas {{icon}} spt-fx-ic"></i>
            <a class="spt-fx-name" data-action="previewFile" title="{{spt "Files.Open"}}">{{name}}{{#if who}} <small>{{who}}</small>{{/if}}</a>
            {{#if device}}<span class="spt-fx-on"><i class="fas {{deviceIcon}}"></i> {{device}}</span>{{/if}}
            {{#if mail}}
            <span class="spt-fx-follow spt-fx-st-{{state}}" title="{{stateTitle}}"><i class="fas {{stateIcon}}"></i></span>
            {{else}}
            <span class="spt-fx-seg" role="radiogroup">
                <a data-action="fileState" data-state="visible" class="{{#if (eq state "visible")}}on visible{{/if}}" role="radio" title="{{spt "Files.State_visible"}}" aria-label="{{spt "Files.State_visible"}}"><i class="fas fa-eye"></i></a>
                <a data-action="fileState" data-state="locked" class="{{#if (eq state "locked")}}on locked{{/if}}" role="radio" title="{{spt "Files.State_locked"}}" aria-label="{{spt "Files.State_locked"}}"><i class="fas fa-lock"></i></a>
                <a data-action="fileState" data-state="hidden" class="{{#if (eq state "hidden")}}on off{{/if}}" role="radio" title="{{spt "Files.State_hidden"}}" aria-label="{{spt "Files.State_hidden"}}"><i class="fas fa-eye-slash"></i></a>
              </span>
            {{/if}}
          </li>
          {{else}}
          <li class="spt-fx-empty">{{spt "Files.Empty"}}</li>
          {{/each}}
        </ul>
      </div>
      {{else}}
      <p class="spt-phone-status">{{spt "Files.NoMatch"}}</p>
      {{/each}}
      {{else}}
      <p class="spt-phone-status">{{spt "Files.NoComputers"}}</p>
      {{/if}}
    </section>
  {{/if}}
  </div>

  {{#if (eq tab "devices")}}
  <footer class="spt-phone-row spt-gm-foot">
    <button type="button" data-action="newPhone"><i class="fas fa-plus"></i> {{spt "NewDevice"}}</button>
  </footer>
  {{/if}}
{{/if}}
</div>
